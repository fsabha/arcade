{
  "name": "arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "games/*"],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "images": "node scripts/make-images.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/shared && tsc -p hub && for g in games/*; do tsc -p $g || exit 1; done"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
